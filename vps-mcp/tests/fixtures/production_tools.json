      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "read_fileOutput",
      "type": "object"
    }
  },
  "write_file": {
    "name": "write_file",
    "description": "Write UTF-8 file inside an allowed repository (up to 1 MiB).",
    "inputSchema": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "write_fileArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "write_fileOutput",
      "type": "object"
    }
  },
  "mkdir": {
    "name": "mkdir",
    "description": "Create a directory within a granted repository.",
    "inputSchema": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "parents": {
          "default": false,
          "title": "Parents",
          "type": "boolean"
        }
      },

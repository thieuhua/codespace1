      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "projectsDictOutput",
      "type": "object"
    }
  },
  "list_files": {
    "name": "list_files",
    "description": "List project directories. Use 'codespace1' or its absolute path for that project.",
    "inputSchema": {
      "properties": {
        "path": {
          "default": ".",
          "title": "Path",
          "type": "string"
        }
      },
      "title": "list_filesArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "items": {
            "type": "string"
          },
          "title": "Result",
          "type": "array"
        }
      },
      "required": [
        "result"
      ],
      "title": "list_filesOutput",
      "type": "object"
    }
  },
  "read_file": {
    "name": "read_file",
    "description": "Read UTF-8 file inside an allowed repository (up to 1 MiB).",
    "inputSchema": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],

        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "mkdirOutput",
      "type": "object"
    }
  },
  "rename": {
    "name": "rename",
    "description": "Rename a file or directory; never overwrite the destination.",
    "inputSchema": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "renameArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "renameOutput",
      "type": "object"
    }
  },
  "remove": {
    "name": "remove",
    "description": "Remove a file or EMPTY directory in an allowed repository, not a repository itself.",
    "inputSchema": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "removeArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "removeOutput",
      "type": "object"
    }
  },
  "git_status": {
    "name": "git_status",
